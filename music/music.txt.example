# Music player settings. Remove ".example" from the name to use this file. The Music Settings
# page (Music > Settings) changes the same values.

# What turning the screen off (POWER or closing the lid) does to music: pause, or play on.
# Playing on keeps the device awake until the music stops, then it powers off as usual.
screen_off = pause

# How far Left and Right jump in an audiobook, in seconds: 10, 15 or 30.
jump = 30

# How big library lists and the queue are: small (10 rows a page), normal (8) or large (7).
# Menus keep slot's own size.
list = normal

# The repeat mode, set on Now Playing's menu (START): off, all or one.
repeat = off

# Show slot's clock and battery in the music screens' header: on or off. Only set here.
clock = off

# Show the next track under Now Playing: on or off. Only set here.
up_next = on

# Take Now Playing's colour from the album picture, a faint wash behind the screen and the
# progress bar: on or off.
color = on

# The music screens' colours: slot (follow slot's Appearance), dark or light.
theme = slot
