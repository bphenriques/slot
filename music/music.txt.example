# Music player settings. Remove ".example" from the name to use this file. The Music Settings
# page (Music > Settings) changes the same values.

# What turning the screen off (POWER or closing the lid) does to music: pause, or play on.
# Playing on keeps the device awake until the music stops, then it powers off as usual.
screen_off = pause

# How far Left and Right jump in an audiobook, in seconds: 10, 15 or 30.
jump = 30

# How big library lists and the queue are: small (10 rows a page), normal (8) or large (7).
# Menus keep slot's own size.
list = normal

# The repeat mode, set on Now Playing's menu (START): off, all or one.
repeat = off

# Show slot's clock and battery in the music screens' header: on or off. Only set here.
clock = off

# Show the next track under Now Playing: on or off. Only set here.
up_next = on

# Take Now Playing's colour from the album picture, a faint wash behind the screen and the
# progress bar: on or off.
color = on

# The music screens' colours: slot (follow slot's Appearance), dark or light.
theme = slot

# What plays the music: muse (plorpOS's Muse) or slot (slot's own player). Only set here; read
# when slot starts.
player = muse

# Both sides alike, for one ear or one speaker: on or off. Slot's player only, where Music
# Settings shows it as Mono Audio.
mono = off

# Each song straight on from the last, with no gap, as live albums need: on or off. Slot's player
# only, where Music Settings shows it.
gapless = on

# Songs, or albums, brought to one loudness from their ReplayGain tags: off, track or album.
# Slot's player only, where Music Settings shows it as Volume Leveling.
leveling = off

# Seconds a song's end fades into the next: 0, 3 or 6. Never a book's. Slot's player only.
crossfade = 0

# For audiobooks, with slot's player: pauses cut short (on or off), and dB louder (0, 3 or 6;
# the loudest is rounded off rather than clipped).
skip_silence = off
boost = 0
