# Music player settings. Remove ".example" from the name to use this file. The Music Settings
# page (Music > Settings) changes the same values.

# What turning the screen off (POWER or closing the lid) does to music: pause, play on (play),
# or play on with the keys locked until the screen is back (locked), so nothing changes in a
# pocket. Music Settings shows these as Pause, Keep Playing and Play Locked. Playing on keeps the
# device awake until the music stops, then it powers off as usual.
screen_off = pause

# Where Music opens from slot's menu: playing (Now Playing, while something plays) or left (where
# it was left).
open = left

# How far Left and Right jump in an audiobook, in seconds: 10, 15 or 30.
jump = 30

# The repeat mode, set on Now Playing's menu (START): off, all or one.
repeat = off

# Both sides alike, for one ear or one speaker: on or off. Music Settings shows it as Mono
# Audio.
mono = off

# Faint bars beside the picture on Now Playing, moving with the music: on or off. Shown as
# Visualizer; while it shows, the screen is drawn more often, which uses a little more battery.
visualizer = off

# Songs brought to one loudness from their ReplayGain tags: on or off. An album keeps its own
# loudness when played in order; shuffled, each song is levelled. Music Settings shows it as Volume
# Leveling. Songs always follow on with no gap.
leveling = off

# Seconds a song's end fades into the next: 0, 3 or 6. Only between albums: one played in
# order stays gapless. Never a book's.
crossfade = 0

# For audiobooks: pauses cut short (on or off), and dB louder (0, 3 or 6;
# the loudest is rounded off rather than clipped).
skip_silence = off
boost = 0

# The equalizer's preset, by its name, or off: one of slot's (Bass Boost, Bass Reducer, Treble
# Boost, Vocal, Loudness) or your own. Make your own in Music Settings > Equalizer > New Preset;
# they are kept in music-eq.txt beside this file, where you can rename them.
eq = off

# Where your songs and audiobooks are: a folder from this card's root (Music), or a whole path,
# such as a folder on the other card, as your device mounts it. Read as slot starts. The settings,
# queue, bookmarks and album pictures stay on this card.
music_folder = Music
books_folder = Audiobooks

# Songs listened to go into .scrobbler.log, for a Last.fm uploader: on or off.
scrobbler = off

# Advanced: the detailed log, and, in a build made with the music-perf feature, the
# performance log: on or off.
perf = off
log = off
